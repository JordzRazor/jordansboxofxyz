{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/css/*", "/js/*", "/demos/*", "/assets/*", "/*.{png,jpg,gif,svg,ico,json,txt}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Cache-Control": "public, max-age=600"
  },
  "mimeTypes": {
    ".wgsl": "text/plain"
  }
}
